EXPO_PUBLIC_APP_ENV=development
# StreetBiz-BE (dotnet run --launch-profile http). "localhost" is swapped for the
# dev machine's LAN address automatically on phones and the Android emulator.
EXPO_PUBLIC_API_BASE_URL=http://localhost:5023/api
# true = run on the in-memory demo data (src/mocks), no backend needed.
EXPO_PUBLIC_USE_MOCK_API=false
EXPO_PUBLIC_ENABLE_AI_COMPLIANCE=false
EXPO_PUBLIC_ENABLE_PHASE_2=false
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=false
# Development only: shows "Thanh toán thử" buttons that call the backend's sandbox endpoints.
EXPO_PUBLIC_ENABLE_PAYMENT_SANDBOX=true
