EXPO_PUBLIC_APP_ENV=development
# Leave unset in development: the app uses the computer Metro runs on, port 5023.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:5023/api
EXPO_PUBLIC_ENABLE_AI_COMPLIANCE=true
EXPO_PUBLIC_ENABLE_PHASE_2=false
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=false
EXPO_PUBLIC_ENABLE_PAYMENT_SANDBOX=false
