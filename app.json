{
  "expo": {
    "name": "StreetBiz",
    "slug": "streetbiz-app",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "streetbiz",
    "userInterfaceStyle": "automatic",
    "platforms": ["android", "ios", "web"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.streetbiz.app"
    },
    "android": {
      "package": "com.streetbiz.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
